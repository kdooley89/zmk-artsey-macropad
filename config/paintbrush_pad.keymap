/*
 * ARTSEY Paintbrush as a macropad. Edit this file, push, and GitHub Actions
 * builds a new .uf2. Positions are numbered 0-3 (top row) and 4-7 (bottom row).
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define MACRO 0
#define MEDIA 1
#define BT    2

/ {
    keymap {
        compatible = "zmk,keymap";

        macro_layer {
            display-name = "Macro";
            // ---------------------------------------
            // |  F13      |  F14  |  F15  |  F16  |
            // |  F17/MEDIA|  F18  |  F19  |  F20  |   hold bottom-left -> Media layer
            // ---------------------------------------
            bindings = <
                &kp F13        &kp F14   &kp F15   &kp F16
                &lt MEDIA F17  &kp F18   &kp F19   &kp F20
            >;
        };

        media_layer {
            display-name = "Media";
            // ---------------------------------------
            // |  Play/Pause |  Vol-  |  Vol+  |  Mute  |
            // |  (held)     |  Prev  |  Next  |  BT    |   hold bottom-right too -> BT layer
            // ---------------------------------------
            bindings = <
                &kp C_PP   &kp C_VOL_DN   &kp C_VOL_UP   &kp C_MUTE
                &trans     &kp C_PREV     &kp C_NEXT     &mo BT
            >;
        };

        bt_layer {
            display-name = "BT";
            // ---------------------------------------
            // |  BT 0   |  BT 1    |  BT 2       |  USB/BT toggle |
            // |  (held) |  BT clr  |  Bootloader |  (held)        |
            // ---------------------------------------
            bindings = <
                &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &out OUT_TOG
                &trans         &bt BT_CLR     &bootloader    &trans
            >;
        };
    };
};

/*
 * ARTSEY Paintbrush as a Figma macropad (macOS shortcuts). Edit this file,
 * push, and GitHub Actions builds a new .uf2.
 * Positions are numbered 0-3 (top row) and 4-7 (bottom row).
 *
 * SPDX-License-Identifier: MIT
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define FIGMA 0
#define EDIT  1
#define SYS   2

// "balanced": holding a layer key and tapping another key counts as a hold
// right away, so you don't have to wait out the tapping term.
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        figma_layer {
            display-name = "Figma";
            // -------------------------------------------------------------
            // |  Undo  ⌘Z     |  Redo ⇧⌘Z  |  Zoom out ⌘-   |  Zoom in ⌘=   |
            // |  Fit ⇧1/EDIT  |  Dup  ⌘D   |  Auto layout ⇧A |  Space (pan) |
            // -------------------------------------------------------------
            // Bottom-left: tap = zoom to fit, hold = Edit layer.
            // Bottom-right: hold and drag to pan the canvas.
            bindings = <
                &kp LG(Z)          &kp LG(LS(Z))   &kp LG(MINUS)   &kp LG(EQUAL)
                &lt EDIT LS(N1)    &kp LG(D)       &kp LS(A)       &kp SPACE
            >;
        };

        edit_layer {
            display-name = "Figma+";
            // -------------------------------------------------------------------
            // |  Copy props ⌥⌘C |  Paste props ⌥⌘V |  Ungroup ⇧⌘G |  Zoom sel ⇧2   |
            // |  (held)         |  Group ⌘G        |  Component ⌥⌘K | UI ⌘\ / SYS  |
            // -------------------------------------------------------------------
            // Bottom-right: tap = show/hide UI, hold = System layer.
            bindings = <
                &kp LA(LG(C))   &kp LA(LG(V))   &kp LG(LS(G))   &kp LS(N2)
                &trans          &kp LG(G)       &kp LA(LG(K))   &lt SYS LG(BSLH)
            >;
        };

        sys_layer {
            display-name = "System";
            // ---------------------------------------
            // |  BT 0   |  BT 1    |  BT 2       |  USB/BT toggle |
            // |  (held) |  BT clr  |  Bootloader |  (held)        |
            // ---------------------------------------
            bindings = <
                &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &out OUT_TOG
                &trans         &bt BT_CLR     &bootloader    &trans
            >;
        };
    };
};
